entity clk_divider is
    generic (N : INTEGER := 4);  -- ?????CLK_N = CLK / N
    port (
        CLK   : in  BIT;         -- ?????
        CLK_N : out BIT          -- ???????
    );
end clk_divider;

architecture behavior of clk_divider is
    signal count    : INTEGER := 0;
    signal clk_out  : BIT := '0';
begin
    process (CLK)
    begin
        if CLK = '1' then
            if count = N/2 - 1 then
                clk_out <= NOT clk_out;
                count <= 0;
            else
                count <= count + 1;
            end if;
        end if;
    end process;

    CLK_N <= clk_out;
end behavior;
